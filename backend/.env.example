# Copie para .env e ajuste (o servidor lê as variáveis do ambiente do processo).
PORT=3001
DB_PATH=almoxarifado.db
# Em produção use um segredo longo e aleatório (o servidor se recusa a iniciar com o padrão).
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=28800
CORS_ORIGIN=http://localhost:5173
